[Unit]
Description=inproxy - path-based reverse proxy for internal HTTP services + admin UI
Documentation=https://localhost/_admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inproxy
Group=inproxy
# provides ADMIN_PASSWORD / PROXY_ADDR / ADMIN_ADDR / TLS_MODE / INTERNAL_CIDR / ...
EnvironmentFile=/etc/inproxy/inproxy.env
ExecStart=/usr/local/bin/inproxy
Restart=on-failure
RestartSec=2

# allow a non-root process to bind privileged ports like 80/443
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# only the config directory is writable (needed to save routes/certs)
ReadWritePaths=/etc/inproxy

[Install]
WantedBy=multi-user.target
