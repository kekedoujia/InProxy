[Unit]
Description=inproxy - path-based reverse proxy for internal HTTP services + admin UI
Documentation=https://localhost/_admin
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=inproxy
Group=inproxy
# provides ADMIN_PASSWORD / PROXY_ADDR / ADMIN_ADDR / TLS_MODE / INTERNAL_CIDR / ...
EnvironmentFile=/etc/inproxy/inproxy.env
ExecStart=/usr/local/bin/inproxy
Restart=on-failure
RestartSec=2

# CAP_NET_BIND_SERVICE: bind privileged ports (80/443) as a non-root process.
# CAP_NET_ADMIN: manage the DNAT page's iptables nat rules (still non-root).
AmbientCapabilities=CAP_NET_BIND_SERVICE CAP_NET_ADMIN
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_NET_ADMIN

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_NETLINK is required by iptables' nf_tables backend (talks to the kernel over netlink)
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
# only the config directory is writable (needed to save routes/certs)
ReadWritePaths=/etc/inproxy

[Install]
WantedBy=multi-user.target
