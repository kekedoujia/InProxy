# inproxy runtime config — usually generated by install.sh.
# After editing manually, run: sudo systemctl restart inproxy

# [Required] Admin UI login password. Change this to a strong secret!
ADMIN_PASSWORD=change-me-please

# ===== External (HTTPS proxy) =====
# Public/internal HTTPS listener (all interfaces). Internal users reach services here too.
PROXY_ADDR=:443
# HTTP on :80 is 301-redirected to HTTPS; in auto mode it also serves ACME challenges. Empty to disable.
HTTP_REDIRECT_ADDR=:80

# Certificate source:
#   auto = Let's Encrypt (EXTERNAL_HOST must be a domain resolving to the external IP, ports 80/443 public)
#   self = auto-generate a self-signed cert (works for a bare IP, browser warning)
#   file = use your own TLS_CERT / TLS_KEY
TLS_MODE=auto
EXTERNAL_HOST=tools.aperture-x.com
ACME_EMAIL=
ACME_CACHE=/etc/inproxy/acme
TLS_CERT=/etc/inproxy/tls/cert.pem
TLS_KEY=/etc/inproxy/tls/key.pem

# ===== Internal (admin UI) =====
# Admin UI listener: bound to the internal IP + dedicated port; the outside cannot connect.
ADMIN_ADDR=10.8.0.1:8443
# Whether the admin UI also uses HTTPS (reuses the self/file cert). Plain HTTP is fine internally.
ADMIN_TLS=false
# Networks allowed to reach the admin UI (comma-separated). The proxy itself is not restricted.
INTERNAL_CIDR=10.8.0.0/24,127.0.0.1/32,::1/128

# Route config file (admin edits are written here and survive restarts).
CONFIG_PATH=/etc/inproxy/config.json
